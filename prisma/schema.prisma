// ─────────────────────────────────────────────────────────────────────────
// Passcit — Database Schema
//
// This schema was designed for the whole application up front. The phase
// labels below are historical — the project's actual phase numbering (see
// README.md's Roadmap) evolved as scope shifted, so these numbers won't
// all match the current roadmap table exactly. They're kept as-is because
// they still correctly describe *when each section started being used*,
// which is the part that matters for reading this file.
//
// Sections:
//   1. Generator / datasource
//   2. Auth (NextAuth/Auth.js standard models + our extensions)
//   3. Civics questions & user progress            [used from Phase 2]
//   4. Flashcards / spaced repetition                (extends section 3)
//   5. Practice tests                                [used from Phase 4]
//   6. Voice practice                                [used from Phase 4, Stage 1-2]
//   7. Streaks & study sessions                      [used from Phase 5]
//   8. Eligibility calculator                        [used from Phase 8]
//   9. Admin: announcements, site settings            [partially used from Phase 5]
//  10. Naturalization Interview Simulation            [used from Phase 7]
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ── 2. Auth ─────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  role          Role      @default(USER)
  // Admin-controlled account status. Checked at login (see auth.ts) — a
  // disabled account can't sign in. Doesn't invalidate an already-active
  // session immediately (sessions are JWT-based/stateless); it takes
  // effect on the account's next login attempt, which is the standard,
  // honest tradeoff of stateless sessions rather than a gap.
  isActive      Boolean   @default(true)

  // Preferred language for AI-generated study content (explanations,
  // translations, memory tips) and for text-to-speech. The official USCIS
  // question and answer are always shown in English regardless.
  studyLanguage StudyLanguage @default(EN)

  // Which TestVersion this user is currently studying. Nullable rather
  // than defaulting to a specific row (Prisma defaults can't reference
  // another table) — application code falls back to TestVersion.isDefault
  // whenever this is unset. Switching this never touches any other data:
  // progress/favorites/flashcard status/practice history all live on rows
  // scoped to a specific Question, and every Question belongs to exactly
  // one TestVersion, so nothing needs migrating when a user switches.
  activeTestVersionId String?
  activeTestVersion   TestVersion? @relation(fields: [activeTestVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  nativeRefreshTokens NativeRefreshToken[]

  // Forward-declared relations used starting in later phases:
  progress          UserQuestionProgress[]
  practiceTests     PracticeTest[]
  voiceAttempts     VoicePracticeAttempt[]
  interviewSimulations InterviewSimulation[]
  studySessions     StudySession[]
  streak            StudyStreak?
  eligibilityChecks EligibilityCalculation[]
  announcements     Announcement[]           @relation("AnnouncementAuthor")
  unitProgress      UnitProgress[]
  lessonProgress    LessonProgress[]
  unitExamAttempts  UnitExamAttempt[]
  xp                UserXP?
  xpEvents          XPEvent[]
  studyActions      StudyActionEvent[]

  @@index([role])
  @@index([activeTestVersionId])
  @@index([isActive])
}

// Standard Auth.js/Prisma-adapter models — do not rename fields, the
// adapter expects these exact shapes.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Bearer-token session for the native iOS app, parallel to (and fully
// independent of) the Session/VerificationToken pair Auth.js uses for the
// web app's cookie sessions — see src/lib/native-auth. Only the refresh
// token is persisted here; the short-lived access token is a stateless,
// self-verifying JWT and is never written to the database. `tokenHash` is
// a one-way SHA-256 hash — the raw refresh token is only ever known to
// the client and is never stored, matching how passwordHash never stores
// a plaintext password.
model NativeRefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ── 3. Civics questions & user progress ────────────────────────────────
//
// Multi-version design: USCIS has published more than one civics test
// (2008 — 100 questions, currently the default; 2020/2025 — 128
// questions, now in effect for applicants who filed on or after Oct 20,
// 2025). Every Question belongs to exactly one TestVersion. Adding a new
// version later — or updating an existing one — is purely a data change
// (a new TestVersion row plus its Questions/QuestionAnswers): nothing
// here needs to change shape. `number` is only unique WITHIN a version
// (see the composite unique below), since a future version's own #1-128
// numbering can legitimately collide with the 2008 test's #1-100.

model TestVersion {
  id             String   @id @default(cuid())
  slug           String   @unique // e.g. "2008", "2025"
  name           String // e.g. "2008 Civics Test"
  year           Int
  totalQuestions Int // size of this version's full question bank
  questionsAsked Int // how many the officer asks at interview
  passThreshold  Int // how many correct are needed to pass
  isDefault      Boolean  @default(false) // exactly one version should be true
  isActive       Boolean  @default(true) // available to study in this app
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  questions      Question[]
  practiceTests  PracticeTest[]
  studySessions  StudySession[]
  activeForUsers User[]
  interviewSimulations InterviewSimulation[]
  units          Unit[]
}

enum QuestionCategory {
  AMERICAN_GOVERNMENT
  AMERICAN_HISTORY
  INTEGRATED_CIVICS
  // The official USCIS 2025 (128-question) test's third top-level
  // section is literally titled "Symbols and Holidays", not "Integrated
  // Civics" — kept as its own value rather than folded into
  // INTEGRATED_CIVICS so the category matches the source document
  // exactly. Used only by the 2025 TestVersion's questions 119-128.
  SYMBOLS_AND_HOLIDAYS
}

// Some civics questions (current President, VP, Speaker of the House,
// Chief Justice) have an answer that changes over time rather than
// being fixed content. Modeled as its own small lookup table, keyed by
// office, so the current value has one place to update and cite a
// source/verification date — see DynamicOfficial.
enum DynamicOfficialKey {
  PRESIDENT
  VICE_PRESIDENT
  SPEAKER_OF_THE_HOUSE
  CHIEF_JUSTICE
}

model DynamicOfficial {
  id             String             @id @default(cuid())
  key            DynamicOfficialKey @unique
  currentValue   String // e.g. "Donald J. Trump"
  sourceUrl      String?
  lastVerifiedAt DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum StudyStatus {
  NEW
  LEARNING
  KNOWN
  NEEDS_PRACTICE
}

model Question {
  id            String      @id @default(cuid())
  testVersionId String
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  number        Int // official USCIS numbering WITHIN this test version

  category    QuestionCategory
  subcategory String // e.g. "Principles of American Democracy"

  question    String  @db.Text
  explanation String? @db.Text

  // Some questions accept more than one distinct answer (see
  // QuestionAnswer) and/or require naming more than one of them, e.g.
  // "Name TWO rights in the Declaration of Independence."
  requiredAnswerCount Int @default(1)

  // Applicants 65+ with 20+ years as a permanent resident only need to
  // study the ~20 questions USCIS marks with an asterisk.
  isSpecial65_20 Boolean @default(false)

  // Answers that change over time (current officials) vs. answers that
  // depend on the applicant's own state/district — these need different
  // UI treatment, so they're tracked separately rather than lumped into
  // one flag.
  isDynamicAnswer    Boolean             @default(false)
  dynamicNote        String?             @db.Text
  // Set only when isDynamicAnswer is true AND this question's answer
  // should be sourced from the DynamicOfficial table at seed time,
  // rather than hardcoded directly in this version's seed JSON.
  dynamicOfficialKey DynamicOfficialKey?
  variesByLocation   Boolean             @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers       QuestionAnswer[]
  tags          QuestionTag[]
  progress      UserQuestionProgress[]
  testAnswers   PracticeTestAnswer[]
  voiceAttempts VoicePracticeAttempt[]
  interviewAnswers InterviewCivicsAnswer[]
  lessonQuestions   LessonQuestion[]
  unitExamQuestions UnitExamQuestion[]
  studyContent      QuestionStudyContent[]
  studyActions      StudyActionEvent[]

  @@unique([testVersionId, number])
  @@index([category])
  @@index([testVersionId, isActive])
}

// One row per acceptable answer. Modeling this as a related table
// (rather than a JSON string array) keeps individual answers queryable
// and indexable — e.g. for search — as the question bank grows.
model QuestionAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// Freeform, cross-cutting labels (e.g. "Constitution", "Elections") —
// distinct from `category`, which is USCIS's own fixed 3-part taxonomy.
model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

model UserQuestionProgress {
  id     String @id @default(cuid())
  userId String
  questionId String

  status     StudyStatus @default(NEW)
  isFavorite Boolean     @default(false)

  timesCorrect   Int @default(0)
  timesIncorrect Int @default(0)

  // Spaced-repetition scheduling (SM-2 style)
  easeFactor   Float     @default(2.5)
  intervalDays Int       @default(0)
  repetitions  Int       @default(0)
  lastReviewedAt DateTime?
  nextReviewAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@index([userId, status])
}

// ── 5. Practice tests ───────────────────────────────────────────────────

enum TestMode {
  RANDOM_10
  FULL_100
  MISSED_ONLY
  CATEGORY
  MOCK_INTERVIEW
}

model PracticeTest {
  id             String    @id @default(cuid())
  userId         String
  testVersionId  String
  mode           TestMode
  category       QuestionCategory?
  score          Int?
  totalQuestions Int
  passed         Boolean?
  // Mock Interview mode replicates the real N-400 rule: the officer
  // stops asking as soon as the applicant passes or can no longer
  // mathematically pass, rather than always asking a fixed number.
  stoppedEarly Boolean   @default(false)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  testVersion TestVersion          @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  answers     PracticeTestAnswer[]

  @@index([userId])
  @@index([testVersionId])
}

model PracticeTestAnswer {
  id           String   @id @default(cuid())
  testId       String
  questionId   String
  userAnswer   String   @db.Text
  isCorrect    Boolean
  timeSpentSec Int?
  answeredAt   DateTime @default(now())

  test     PracticeTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([testId])
}

// ── 6. Voice practice ────────────────────────────────────────────────────

enum VoiceEvaluationResult {
  CORRECT
  ALMOST_CORRECT
  INCORRECT
}

model VoicePracticeAttempt {
  id         String                 @id @default(cuid())
  userId     String
  questionId String
  transcript String                 @db.Text
  result     VoiceEvaluationResult
  feedback   String?                @db.Text
  createdAt  DateTime               @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── 7. Streaks & study sessions ─────────────────────────────────────────

model StudyStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastStudyDate    DateTime?
  freezesAvailable Int       @default(0)
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id                String   @id @default(cuid())
  userId            String
  testVersionId     String
  date              DateTime @db.Date
  minutesStudied    Int      @default(0)
  questionsReviewed Int      @default(0)
  createdAt         DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)

  // A user can have separate activity logged per version per day (rare,
  // but architecturally correct if someone studies both in one sitting).
  @@unique([userId, date, testVersionId])
}

// ── 8. Eligibility calculator ───────────────────────────────────────────

enum EligibilityBasis {
  GENERAL // 5-year permanent residence
  MARRIED_TO_CITIZEN // 3-year, married to & living with a U.S. citizen
  MILITARY // INA 328/329 — deliberately not calculated by this tool; see EligibilityCalculation model comment
}

enum MilitaryServiceType {
  MANDATORY
  VOLUNTARY
}

model EligibilityCalculation {
  id     String @id @default(cuid())
  userId String?

  basis              EligibilityBasis @default(GENERAL)
  greenCardDate      DateTime
  state              String
  birthDate          DateTime?

  marriedToUSCitizen Boolean @default(false)
  spouseIsUSCitizen  Boolean @default(false)

  // Military service (basis = MILITARY). All nullable — only collected
  // and only meaningful when that path is chosen. Deliberately, this
  // tool never calculates an eligibility date through INA 328/329: real
  // eligibility there turns on discharge characterization, designated
  // periods of hostility, and current-vs-former service status, all of
  // which USCIS determines case by case. Selecting MILITARY routes
  // straight to a "gather these documents, consult USCIS or an
  // immigration attorney" result instead of a computed date.
  militaryCountryServed    String?
  militaryServiceType      MilitaryServiceType?
  militaryServiceStart     DateTime?
  militaryServiceEnd       DateTime?
  militaryCurrentlyServing Boolean?
  militaryUSArmedForces    Boolean?

  travelHistory      Json? // array of { departDate, returnDate, days }
  totalDaysOutsideUS Int   @default(0)
  longestTripDays    Int   @default(0)

  selectiveServiceRequired   Boolean?
  selectiveServiceRegistered Boolean?

  eligibleFilingDate      DateTime
  requiredResidencyYears  Int
  physicalPresenceDaysReq Int
  continuousResidenceOk   Boolean  @default(true)

  warnings Json? // string[] of flagged/missing requirements

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── 9. Admin ─────────────────────────────────────────────────────────────

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("AnnouncementAuthor", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([isActive])
}

// Site-wide configuration, edited from the admin Settings page. A
// singleton by convention (application code always reads/writes the row
// with id "singleton"), not a database-level constraint — Prisma/MySQL
// have no clean native way to enforce "at most one row," and a
// well-known fixed id is a common, simple way to get the same effect.
//
// "Default Test Version" is deliberately NOT duplicated here — it's
// TestVersion.isDefault, which already exists and is the single source
// of truth app-wide. The Settings page reads/writes that field directly
// rather than mirroring it into a second place it could drift out of
// sync with.
//
// "Voice Defaults" (voiceDefaultRate) is stored and editable here, but
// deliberately NOT wired into src/hooks/useSpeech.ts — connecting it
// would mean modifying a Voice Playback file, which this phase leaves
// untouched. Wiring it up is a natural, contained follow-up.
model SiteSettings {
  id               String   @id @default(cuid())
  siteName         String   @default("Passcit")
  logoUrl          String?
  voiceDefaultRate Float    @default(1)
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

// ── 10. Naturalization Interview Simulation ────────────────────────────
//
// A full, guided walkthrough of a real N-400 interview: identity/speaking
// practice, then the Reading and Writing portions of the English test,
// then the Civics test — each section independently pass/failed, matching
// how USCIS actually retests only the failed portion rather than the
// whole interview. See PHASE-7-INTERVIEW-SIMULATION.md for the design
// rationale, especially why identity-question answers are never stored.

enum InterviewSectionResult {
  PASSED
  FAILED
  // The interview was abandoned (browser closed, navigated away) before
  // this section was reached. Distinct from FAILED so a partial attempt
  // in history doesn't look like a failed test the applicant actually sat.
  NOT_REACHED
}

model InterviewSimulation {
  id            String @id @default(cuid())
  userId        String
  testVersionId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationSec Int? // set once, at completion

  // Identity Questions (speaking practice) — deliberately has no score
  // and no stored answer text. See the model-level note above.
  identityQuestionsCompleted Boolean @default(false)

  readingResult InterviewSectionResult @default(NOT_REACHED)
  // Each entry: { sentence: string, transcript: string, isCorrect: boolean }.
  // Bounded to at most 3 (USCIS shows at most 3 reading sentences), so a
  // JSON column is simpler than a relational table here — unlike civics,
  // there's no cross-interview aggregate query (like "most missed
  // sentence") that would need this to be queryable on its own.
  readingAttempts Json?

  writingResult InterviewSectionResult @default(NOT_REACHED)
  // Each entry: { sentence: string, typedAnswer: string, isCorrect: boolean }.
  writingAttempts Json?

  civicsResult         InterviewSectionResult @default(NOT_REACHED)
  civicsCorrectCount   Int                    @default(0)
  civicsIncorrectCount Int                    @default(0)

  // Null while in progress. True only if every section that was actually
  // reached passed — Reading/Writing/Civics all graded independently, so
  // this is a derived summary computed once at completion, not a fourth
  // independent judgment call.
  passed Boolean?

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  testVersion   TestVersion             @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  civicsAnswers InterviewCivicsAnswer[]

  @@index([userId])
  @@index([testVersionId])
  @@index([userId, completedAt])
}

// One row per civics question actually asked during an interview —
// mirrors PracticeTestAnswer's shape deliberately, since it serves the
// same two purposes: per-interview "here's what you said" review, and
// cross-interview admin analytics (most-missed questions, weakest
// categories) that a JSON blob couldn't answer efficiently.
model InterviewCivicsAnswer {
  id          String   @id @default(cuid())
  interviewId String
  questionId  String
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  // Transcribed speech (or typed fallback) — kept for the review screen,
  // not scored against anything beyond the original evaluateAnswer() call
  // made when the answer was given.
  spokenAnswer String @db.Text

  interview InterviewSimulation @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([interviewId])
  @@index([questionId])
}

// ── 11. Learning Roadmap ────────────────────────────────────────────────
//
// A structured Unit -> Lesson -> Unit Exam progression, layered ON TOP of
// the existing per-question mastery system (UserQuestionProgress/SM-2) —
// not a replacement for it. LessonQuestion/UnitExamQuestion are pure join
// tables against the existing Question bank; no question content is ever
// duplicated or fabricated here (see prisma/seed-roadmap.ts).
//
// Unlock state (LOCKED/AVAILABLE/IN_PROGRESS/COMPLETED) is computed at
// read time by src/lib/roadmap.ts from whatever UnitProgress/
// LessonProgress rows happen to exist — a missing row simply means "not
// yet touched," which the computation treats as its correct default.
// Read (GET) endpoints never create these rows; only the write endpoints
// (lesson complete, exam start/complete) do.

model Unit {
  id            String      @id @default(cuid())
  testVersionId String
  testVersion   TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String?     @db.Text
  order         Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  lessons      Lesson[]
  exam         UnitExam?
  unitProgress UnitProgress[]

  @@unique([testVersionId, order])
  @@unique([testVersionId, slug])
  @@index([testVersionId, isActive])
}

model Lesson {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  summary   String?  @db.Text
  order     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonQuestions LessonQuestion[]
  lessonProgress  LessonProgress[]

  @@unique([unitId, order])
  @@unique([unitId, slug])
  @@index([unitId, isActive])
}

// Pure join table — assigns an EXISTING Question to a Lesson, ordered.
// A Question can appear in more than one lesson; nothing about Question
// is ever duplicated or modified by this table.
model LessonQuestion {
  id         String   @id @default(cuid())
  lessonId   String
  questionId String
  order      Int

  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([lessonId, questionId])
  @@unique([lessonId, order])
  @@index([questionId])
}

model UnitExam {
  id            String   @id @default(cuid())
  unitId        String   @unique
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questionCount Int
  passThreshold Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examQuestions UnitExamQuestion[]
  attempts      UnitExamAttempt[]
}

// Optional curated question pool for an exam. If a UnitExam has none, exam
// question selection falls back to drawing from the unit's own
// LessonQuestion pool instead (see src/lib/roadmap-progress.ts).
model UnitExamQuestion {
  id         String   @id @default(cuid())
  unitExamId String
  questionId String

  unitExam UnitExam @relation(fields: [unitExamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([unitExamId, questionId])
  @@index([questionId])
}

enum UnitExamAttemptResult {
  IN_PROGRESS
  PASSED
  FAILED
}

model UnitExamAttempt {
  id             String                @id @default(cuid())
  unitExamId     String
  userId         String
  score          Int?
  totalQuestions Int
  result         UnitExamAttemptResult @default(IN_PROGRESS)
  // The exact, ordered set of Question ids drawn for this specific
  // attempt, fixed at start time. Grading at completion validates the
  // submission against exactly this set — never against whatever the
  // question pool looks like by the time the attempt is submitted, and
  // never allowing a duplicate/substituted question id to sneak in.
  // Bounded (questionCount is small) and never queried across attempts,
  // so a JSON column is simpler here than a relational table — the same
  // reasoning already used for InterviewSimulation.readingAttempts.
  questionIds Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  unitExam UnitExam @relation(fields: [unitExamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unitExamId])
}

enum ProgressStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}

model UnitProgress {
  id          String         @id @default(cuid())
  userId      String
  unitId      String
  // COMPLETED/examPassed are the only durable facts this row exists to
  // record — LOCKED/AVAILABLE/IN_PROGRESS are always re-derived live at
  // read time (see src/lib/roadmap.ts), never trusted as stored state,
  // so `status` here only ever meaningfully holds COMPLETED in practice.
  status      ProgressStatus @default(LOCKED)
  examPassed  Boolean        @default(false)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId, status])
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(LOCKED)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

// ── 12. XP ───────────────────────────────────────────────────────────────
//
// Motivational only — see src/lib/xp.ts. XP is never read by roadmap
// unlock logic (src/lib/roadmap.ts); it is purely a side effect of
// completion events, never an input to them. UserXP.totalXP is a
// denormalized running total, incremented transactionally alongside each
// XPEvent insert; XPEvent itself is the append-only audit/reconciliation
// source and is never summed on normal reads.

model UserXP {
  userId    String   @id
  totalXP   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum XPReason {
  LESSON_COMPLETED
  UNIT_EXAM_PASSED
  PRACTICE_TEST_COMPLETED
  DAILY_GOAL_MET
  STREAK_BONUS
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    XPReason
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── 13. AI-generated study content ─────────────────────────────────────
//
// Restored from the pre-roadmap version of this app (see
// ~/Downloads/passcit at commit e0c630d) — the old web app's Study Panel
// feature (explanation / translation / memory tip / Listen on each
// question), now ported to power the same experience in the native iOS
// Learn tab. Layered entirely on top of the existing Question bank; no
// question content is duplicated or altered by anything here.

/// Languages offered for AI-generated study content.
///
/// Modelled as an enum rather than a free String deliberately: the cache
/// key for generated content is (questionId, language), so any drift in
/// how a language is spelled — "es" vs "ES" vs "spanish" — would silently
/// create a second row and pay the generation cost again for content that
/// already exists. The database constraint makes that class of mistake
/// impossible. Adding a language later is a one-line migration.
enum StudyLanguage {
  EN // English (default — also the language of the official USCIS content)
  AR // العربية
  ES // Español
  HI // हिन्दी
  UR // اردو
  FR // Français
  PT // Português
  ZH // 中文
  RU // Русский
  KO // 한국어
  VI // Tiếng Việt
  TL // Tagalog
}

/// One row per (question, language) holding every kind of generated study
/// content for that pair.
///
/// Each field is NULL until the user first presses the button that needs
/// it, then filled in and kept permanently — so a question the user only
/// ever asks for a memory tip on never pays to generate an explanation.
/// Deliberately one row rather than a row per content type: the three
/// kinds share a cache key exactly, and separate rows would mean three
/// lookups and three inserts for the same conceptual entry.
///
/// Content here is never regenerated except by explicit administrator
/// action; ordinary reads always return what is already stored.
model QuestionStudyContent {
  id         String        @id @default(cuid())
  questionId String
  language   StudyLanguage

  /// Why the answer is correct, with context, written for the selected language.
  explanation        String? @db.Text
  /// The official question, translated. Never replaces the English original.
  translatedQuestion String? @db.Text
  /// The official answer, translated. Never replaces the English original.
  translatedAnswer   String? @db.Text
  /// A mnemonic, association, or everyday analogy for recalling the answer.
  memoryTip          String? @db.Text

  // Status and provenance are tracked per content type rather than once per
  // row. A single status could not express "explanation completed, memory
  // tip failed, translation never requested", which is the normal state of
  // a row given the three are generated independently on demand. Recording
  // aiVersion per type is likewise what makes it possible to regenerate
  // just the explanations with a newer model while leaving everything else
  // untouched. Translation is one unit: question and answer come from a
  // single call, so they share one status.
  explanationStatus      StudyContentStatus @default(PENDING)
  explanationAiVersion   String?
  explanationGeneratedAt DateTime?
  explanationDurationMs  Int?

  translationStatus      StudyContentStatus @default(PENDING)
  translationAiVersion   String?
  translationGeneratedAt DateTime?
  translationDurationMs  Int?

  memoryTipStatus        StudyContentStatus @default(PENDING)
  memoryTipAiVersion     String?
  memoryTipGeneratedAt   DateTime?
  memoryTipDurationMs    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
}

/// Lifecycle of one kind of generated content.
///
/// GENERATING is a claim held by whichever request won the atomic update
/// that set it — that is what stops two people opening the same question in
/// the same language from both paying for a generation. A status column on
/// its own would not prevent that; only the conditional write does.
enum StudyContentStatus {
  PENDING // never requested
  GENERATING // a request holds the claim right now
  COMPLETED // content is stored and served from cache
  FAILED // last attempt failed; the user may retry
}

enum StudyActionType {
  EXPLANATION
  TRANSLATION
  MEMORY_TIP
  LISTEN
}

/// One row per study action, for understanding which aids people actually
/// use and in which languages. Deliberately records the action and its
/// language only — never the generated text, which already lives in
/// QuestionStudyContent and would be duplicated here for no benefit.
model StudyActionEvent {
  id         String          @id @default(cuid())
  userId     String
  questionId String
  action     StudyActionType
  language   StudyLanguage
  createdAt  DateTime        @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId, action])
  @@index([action, createdAt])
}

/// Which kind of study content a generation produced.
enum AIContentType {
  EXPLANATION
  TRANSLATION
  MEMORY_TIP
}

/// One row per completed OpenAI call, for cost and usage analysis.
///
/// Never shown to end users. Deliberately stores no userId: rate limiting
/// already handles abuse in real time, and cost analysis needs the shape of
/// spend (which content type, which language, which model), not who caused
/// it. Add a nullable userId later if per-user attribution is wanted.
///
/// Token counts are reported by the API and are exact. estimatedCostUsd is
/// derived from a local price table and will drift when OpenAI changes
/// pricing — treat it as an estimate, and recompute from tokens if exact
/// figures are ever needed.
model AIGenerationLog {
  id String @id @default(cuid())

  questionId  String?
  language    StudyLanguage
  contentType AIContentType

  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Float?
  durationMs       Int

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([contentType])
  @@index([language])
}
