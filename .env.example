# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit your actual .env file.
# ─────────────────────────────────────────────────────────────

# MySQL connection string.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Local dev (with the included docker-compose.yml):
DATABASE_URL="mysql://civicsprep:civicsprep@localhost:3306/civicsprep"
# Hostinger example:
# DATABASE_URL="mysql://u123456789_app:yourpassword@srv1234.hstgr.io:3306/u123456789_passcit"

# Auth.js (NextAuth v5) secret — generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Your app's public base URL (used to build links in emails, etc.)
APP_URL="http://localhost:3000"

# ── Optional: Google sign-in ───────────────────────────────────
# Leave blank to disable Google login (credentials login always works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Optional: SMTP for password-reset emails ───────────────────
# Leave blank during local dev — reset links will be printed to the
# server console instead of emailed. Hostinger's SMTP works fine here,
# as does any provider (Resend, SendGrid, Gmail app password, etc.).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Passcit <no-reply@yourdomain.com>"

# ── Optional: bootstrap an admin account on first seed ─────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
